APP_NAME=Mailhub
APP_DOMAIN=private-mailhub.com

# Backend API URL. Do not append /api; the frontend adds it to requests.
VITE_API_URL=http://localhost:8080

# Must match the backend repository ENCRYPTION_KEY; visible in the browser bundle.
VITE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
